# Copy to .env and adjust. Docker Compose reads this file automatically.
# No real credentials belong in version control; these are local development defaults.

# --- Host ports (chosen to avoid a local PostgreSQL on 5432 or an app on 8080) ---
CONTRACTGUARD_WEB_PORT=5173
CONTRACTGUARD_PORT=8081
CONTRACTGUARD_DB_PORT=55432

# --- Database ---
CONTRACTGUARD_DB_NAME=contractguard
CONTRACTGUARD_DB_USERNAME=contractguard
# Change this before exposing the stack anywhere other than localhost.
CONTRACTGUARD_DB_PASSWORD=contractguard
